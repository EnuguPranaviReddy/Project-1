# Copy to .env and fill in. Never commit the real .env.
#
# These are SERVER-SIDE values consumed by the Java backend. The service-role key is a
# full-privilege secret - it must never reach the browser.

SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional overrides (the defaults are already correct for `docker compose up` locally)
#TEMPORAL_TARGET=localhost:7233
#TEMPORAL_NAMESPACE=default
#TEMPORAL_TASK_QUEUE=aero-tq
