# Copy to .env and edit. In development the Vite proxy already routes /api and /ws to
# the backend, so API_BASE can stay empty — that is the recommended setup.

VITE_API_BASE=

# Latitude,Longitude the globe flies to on load.
VITE_MAP_CENTER=17.3850,78.4867

# Only needed if you later read Supabase straight from the browser. Week 1/2 read it
# through the Java backend instead, so these stay empty.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
