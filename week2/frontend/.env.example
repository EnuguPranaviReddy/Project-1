# Copy to .env and edit. In development the Vite proxy already routes /api and /ws to
# the backend, so both of the first two can stay empty — that is the recommended setup.

VITE_API_BASE=

# ws:// or wss:// URL of the telemetry gateway. Leave empty to use the current origin
# plus /ws/telemetry, which is what the Vite proxy expects.
VITE_WS_URL=

# Latitude,Longitude the globe flies to on load.
VITE_MAP_CENTER=17.3850,78.4867

# The dashboard reads mission history through the Java backend (GET /api/missions/history),
# so these are NOT needed. Only fill them in if you later switch to reading Supabase
# directly from the browser — which would require the anon key plus the RLS SELECT
# policies in supabase/schema.sql, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
