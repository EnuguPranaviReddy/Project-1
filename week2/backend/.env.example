# Copy to .env and fill in. Never commit the real .env.
#
# SERVER-SIDE only. The service-role key bypasses Row Level Security - it must never
# reach the browser. If the frontend ever needs direct Supabase access, use the anon
# key plus RLS policies instead.

SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional overrides (defaults already match `docker compose up` locally)
#TEMPORAL_TARGET=localhost:7233
#TEMPORAL_NAMESPACE=default
#TEMPORAL_TASK_QUEUE=aero-tq
#TELEMETRY_TICK_MS=1000
#DEMO_FLEET_SIZE=50
